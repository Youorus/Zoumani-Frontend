# URL publique du site. Sert de base à metadataBase, aux URL canoniques,
# au sitemap et au robots.txt. C'est LA valeur à changer le jour où le
# domaine définitif est branché.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Autorise les moteurs de recherche à indexer le site. Volontairement
# explicite : sans "true", le site répond noindex et un robots.txt
# bloquant. À ne passer à "true" que sur le domaine définitif, jamais sur
# un domaine temporaire.
NEXT_PUBLIC_SEO_INDEXABLE=false

# Numéro de contact, au format international sans espace. Le + est optionnel.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Les deux fiches de l'application mobile.
#
# Tant qu'elles sont vides, le site annonce « bientôt disponible » au lieu
# d'afficher des boutons qui mèneraient à une page introuvable. Le jour de
# la publication, il n'y a que ces deux lignes à renseigner.
NEXT_PUBLIC_APP_STORE_URL=
NEXT_PUBLIC_PLAY_STORE_URL=

# Codes de vérification des consoles moteurs de recherche (optionnels).
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=

# ── API ──────────────────────────────────────────────────────────────────────
# Racine versionnee de l'API Zoumani — la meme que l'application mobile.
# Elle recoit les preinscriptions : POST /prelaunch/leads.
#
# Figee au build (voir Dockerfile) : la changer demande de reconstruire
# l'image, pas seulement de redemarrer le conteneur.
#
# Laissee vide, le tunnel affiche une erreur franche au lieu de faire croire
# a un enregistrement. La vitrine, elle, reste entierement statique.
NEXT_PUBLIC_API_URL=https://api.zoumani.fr/api/v1
