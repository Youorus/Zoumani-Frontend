# URL publique du site. Sert de base a metadataBase, aux URLs canoniques,
# au sitemap et au robots.txt. C'est LA valeur a changer le jour ou le
# domaine definitif est branche.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Autorise les moteurs de recherche a indexer le site. Volontairement explicite :
# sans "true", le site repond noindex et un robots.txt bloquant. A ne passer a
# "true" que sur le domaine definitif, jamais sur un domaine temporaire.
NEXT_PUBLIC_SEO_INDEXABLE=false

# URL de l'API, lue UNIQUEMENT cote serveur.
#
# Sans prefixe NEXT_PUBLIC_ : ce qui porte ce prefixe finit dans le
# bundle envoye au navigateur, donc est public. Or le navigateur n'a
# plus besoin de connaitre l'API : il n'appelle que sa propre origine,
# et c'est le serveur Next qui relaie en ajoutant le jeton lu dans un
# cookie httpOnly.
API_URL=http://localhost:8000/api/v1

# Format international, sans espace. Le signe + est optionnel.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Codes de verification des consoles moteurs de recherche (optionnels).
# A renseigner une fois les proprietes creees.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
NEXT_PUBLIC_BING_SITE_VERIFICATION=
NEXT_PUBLIC_YANDEX_VERIFICATION=
